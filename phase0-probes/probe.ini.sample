; LSAX Phase 0 disposable probe configuration. Copy to GTA V/scripts/LSAXProbe/probe.ini
; NOT LSAX production configuration.

; P-SL-01 (passive). Comma-separated stat names to TEST for existence/persistence (hypotheses, not facts).
PlaytimeStatCandidates=TOTAL_PLAYING_TIME,SP0_TOTAL_PLAYING_TIME,SP1_TOTAL_PLAYING_TIME,SP2_TOTAL_PLAYING_TIME,LEADERBOARD_PLAYING_TIME
; Override only if your saves are elsewhere.
; SaveRoot=C:\Users\<you>\Documents\Rockstar Games\GTA V\Profiles

; P-SL-02 (writes SP stats; disposable save only)
AnchorProbe.Enabled=false
AnchorProbe.Consent=
AnchorProbe.CandidateStats=
AnchorProbe.WriteKey=F9
AnchorProbe.RestoreKey=F11

; P-ID-01
IdentityProbe.Enabled=false
IdentityProbe.TagKey=F10

; P-DB-01
SqliteProbe.Enabled=false
; SqliteProbe.NativePath=C:\Games\GTA V\scripts\LSAXProbeSql\runtimes\win-x64\native\e_sqlite3.dll
SqliteProbe.CloseOnAbort=true
